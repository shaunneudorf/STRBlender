<Window x:Class="STRBlender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STRBlender"
        WindowState="Maximized"
        Height="980" Width="1680">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Nav Sidebar -->
        <Border Grid.Column="0" Background="#ECECEC" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
            <StackPanel Margin="8,12,8,0">
                <TextBlock Text="STRBlender" FontWeight="Bold" FontSize="11" 
                           TextWrapping="Wrap" Margin="0,0,0,16" TextAlignment="Center"/>
                <Button x:Name="nav_Epg" Content="EPG&#x0a;Simulator" 
                        Click="Nav_Epg_Click" Padding="6,10" Margin="0,0,0,4"
                        FontSize="11" TextBlock.TextAlignment="Center"/>
                <Button x:Name="nav_Noc" Content="NOC&#x0a;Game" 
                        Click="Nav_Noc_Click" Padding="6,10" Margin="0,0,0,4"
                        FontSize="11" TextBlock.TextAlignment="Center"/>
                <Button x:Name="nav_Relatives" Content="Relatives" 
                        Click="Nav_Relatives_Click" Padding="6,10" Margin="0,0,0,4"
                        FontSize="11"/>
                <Button x:Name="nav_Synthetic" Content="Synthetic&#x0a;Profiles" 
                        Click="Nav_Synthetic_Click" Padding="6,10" Margin="0,0,0,4"
                        FontSize="11" TextBlock.TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ContentControl Grid.Column="1" x:Name="MainContent"/>
    </Grid>
</Window>