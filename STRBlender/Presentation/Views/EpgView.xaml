<UserControl x:Class="STRBlender.Presentation.Views.EpgView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:STRBlender.Presentation.ViewModels"
             xmlns:controls="clr-namespace:STRBlender.Presentation.Views.Controls">

    <UserControl.DataContext>
        <local:MainViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <!-- Left: Contributors, full height -->
            <ColumnDefinition Width="*"/>
            <!-- Right: EPG + bottom bar -->
        </Grid.ColumnDefinitions>

        <!-- Left: Contributors (now spans the whole window height) -->
        <DockPanel Grid.Column="0" Margin="10">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Label Content="Kit"/>
                <ComboBox x:Name="comboBox_Kit" SelectionChanged="ComboBox_Kit_SelectionChanged" Height="28"/>

                <Label Content="Template (RFU)" Margin="0,12,0,0"/>
                <Slider x:Name="slider_Template" Minimum="1" Maximum="10000"
                        Value="{Binding Template, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding Template, StringFormat={}{0:0}}" HorizontalAlignment="Center"/>

                <Label Content="Contributors" Margin="0,12,0,0"/>
                <Slider x:Name="slider_Contributors" Minimum="1" Maximum="10"
                        Value="{Binding ContributorCount, Mode=TwoWay}" TickFrequency="1"
                        IsSnapToTickEnabled="True" ValueChanged="Slider_Contributors_ValueChanged"/>
                <TextBlock Text="{Binding ContributorCount}" HorizontalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="panel_Contributors"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Right: EPG on top, results/bottom bar below it -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <!-- EPG plot -->
                <RowDefinition Height="280" />
                <!-- Bottom bar -->
            </Grid.RowDefinitions>

            <controls:EpgPlotHost x:Name="epgHost" Grid.Row="0" Margin="8"/>

            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="480"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Results Table -->
                <DataGrid Grid.Column="0" x:Name="dataGrid_Results"
                          ItemsSource="{Binding Results}"
                          AutoGenerateColumns="False" IsReadOnly="True" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Locus" Binding="{Binding Locus}" Width="100"/>
                        <DataGridTextColumn Header="Allele" Binding="{Binding Allele}" Width="75"/>
                        <DataGridTextColumn Header="MW" Binding="{Binding Mw}" Width="75"/>
                        <DataGridTextColumn Header="Height" Binding="{Binding Height}" Width="75"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Sample Information -->
                <GroupBox Grid.Column="1" Header="Sample Information" Margin="8,4">
                    <StackPanel Margin="8">
                        <TextBlock Text="File Number"/>
                        <TextBox Text="{Binding FileNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                        <TextBlock Text="Exhibit Number" Margin="0,6,0,2"/>
                        <TextBox Text="{Binding ExhibitNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Item Number" Margin="0,6,0,2"/>
                        <TextBox Text="{Binding ItemNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <CheckBox Content="Append to existing file (if sample name doesn't exist)"
                                  IsChecked="{Binding AppendToFile, Mode=TwoWay}"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Buttons -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="15,20,10,0">
                    <Button Content="Run Simulation" Click="btn_Run_Click" FontWeight="Bold" Padding="12,10" Margin="0,6"/>
                    <Button Content="Resample" Click="btn_Resample_Click" Padding="12,10" Margin="0,6"/>
                    <Button Content="View Contributors" Click="btn_ViewContributors_Click" Padding="12,10" Margin="0,6"/>
                    <Button Content="Export Sample" Click="btn_ExportSample_Click" Padding="12,10" Margin="0,6"/>
                    <Button Content="Export Reference" Click="btn_ExportReference_Click" Padding="12,10" Margin="0,6"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>