<UserControl x:Class="STRBlender.Presentation.Views.ProfileGenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:STRBlender.Presentation.ViewModels"
             xmlns:controls="clr-namespace:STRBlender.Presentation.Views.Controls">

    <UserControl.DataContext>
        <local:SyntheticProfilesViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: same structure as EPG simulator -->
        <DockPanel Grid.Column="0" Margin="10">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Synthetic Profiles" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

                <Label Content="Kit"/>
                <ComboBox x:Name="comboBox_Kit"
                          SelectionChanged="ComboBox_Kit_SelectionChanged"
                          Height="28"/>

                <Label Content="Template (RFU)" Margin="0,12,0,0"/>
                <Slider x:Name="slider_Template" Minimum="1" Maximum="10000"
                        Value="{Binding Template, Mode=TwoWay}"
                        TickFrequency="1" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding Template, StringFormat={}{0:0}}" HorizontalAlignment="Center"/>

                <Label Content="Contributors" Margin="0,12,0,0"/>
                <Slider x:Name="slider_Contributors" Minimum="1" Maximum="10"
                        Value="{Binding ContributorCount, Mode=TwoWay}"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="Slider_Contributors_ValueChanged"/>
                <TextBlock Text="{Binding ContributorCount}" HorizontalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="panel_Contributors"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Right: batch controls -->
        <Grid Grid.Column="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F7F7F7" Padding="16" CornerRadius="4" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Batch generation" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#444" Margin="0,0,0,12"
                               Text="Same contributor setup as the EPG simulator. Each sample is a fresh genotype draw with fixed quantitative settings."/>

                    <!-- Output mode -->
                    <TextBlock Text="Output format" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton Content="STRmix sample (.txt)"
                                     IsChecked="{Binding IsStrmixTxt, Mode=TwoWay}"
                                     Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <RadioButton Content="ML training (.csv pair)"
                                     IsChecked="{Binding IsMlCsv, Mode=TwoWay}"
                                     VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding OutputModeDescription}"
                               FontSize="11" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Number of profiles" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                                 Text="{Binding ProfileCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28" TextAlignment="Center" Margin="0,4"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Starting series" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                            <TextBox Width="120" HorizontalAlignment="Left"
                                     Text="{Binding StartingSeries, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" TextAlignment="Center"/>
                            <TextBlock Text="{Binding NamingPreview}" FontSize="11" Foreground="#336699"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="btn_Generate" Content="Generate &amp; Export…"
                                Padding="16,8" FontWeight="SemiBold" Margin="0,0,8,0"
                                Click="Btn_Generate_Click"
                                IsEnabled="{Binding IsIdle}"/>
                        <Button x:Name="btn_Cancel" Content="Cancel"
                                Padding="16,8"
                                Click="Btn_Cancel_Click"
                                IsEnabled="{Binding IsRunning}"/>
                    </StackPanel>

                    <ProgressBar Height="16" Margin="0,16,0,4"
                                 Minimum="0"
                                 Maximum="{Binding ProgressTotal}"
                                 Value="{Binding ProgressDone}"/>
                    <TextBlock Text="{Binding ProgressText}" FontSize="11"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Margin="0,8,0,0"
                               TextWrapping="Wrap" Foreground="#333"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#FAFAFA" Padding="16" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="20" FontSize="12"
                               Text="• STRmix .txt — one file, multiple samples (append-style layout, new file each run).&#x0a;• ML CSV — two files sharing sample_id:&#x0a;    *_mixtures.csv — kit, template, noc, prop/deg/sex/db/rel, then per locus allele_1..20 + height_1..20 (allele ascending, post-threshold).&#x0a;    *_truth.csv — same sample_id, contributor params, and Ck_locus_a1/a2 genotypes.&#x0a;• Sample names: 0001-AA, 0001-AB, …"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
